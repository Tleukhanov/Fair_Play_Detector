APP_ENV=development
APP_NAME=fair-play-detector
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Configure integrations in later implementation stages. Do not commit secrets.
LICHESS_API_BASE_URL=https://lichess.org
DATABASE_URL=sqlite+aiosqlite:///./data/fair_play.db
ANALYSIS_DEPTH=15
ANALYSIS_TIME_MS=100
MAX_CONCURRENT_SCANS=2
MAX_PENDING_SCANS=20

# Phase 2: PostgreSQL and Redis integrations.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fair_play_detector
# REDIS_URL=redis://localhost:6379/0
