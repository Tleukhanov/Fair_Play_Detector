APP_ENV=development
APP_NAME=fair-play-detector
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Configure integrations in later implementation stages. Do not commit secrets.
LICHESS_API_BASE_URL=https://lichess.org
DATABASE_URL=sqlite+aiosqlite:///./data/fair_play.db
# Absolute path to a Stockfish binary, or a name resolvable through PATH.
STOCKFISH_PATH=/usr/games/stockfish
# Directory holding model.joblib/metadata.json; the baseline scorer is used when absent.
MODEL_DIR=data/models/chessfraud-v1
ANALYSIS_DEPTH=15
ANALYSIS_TIME_MS=100
# Non-terminal scans older than this are failed on API startup.
STALE_SCAN_MINUTES=60
MAX_CONCURRENT_SCANS=2
MAX_PENDING_SCANS=20

# Grounded LLM explanations for the explaining pipeline stage.
# The feature is enabled by default, but with LLM_API_KEY empty the deterministic
# explainer is used and no network request is made. Never commit a real key.
LLM_ENABLED=true
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=900
# Optional path to an alternative knowledge.json; empty uses the package default.
LLM_KNOWLEDGE_PATH=
#
# OpenRouter (OpenAI-compatible endpoint):
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1
#
# Google Gemini:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Phase 2: PostgreSQL and Redis integrations.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fair_play_detector
# REDIS_URL=redis://localhost:6379/0
